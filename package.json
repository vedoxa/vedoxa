{
  "name": "vedoxa",
  "version": "0.2.0",
  "private": true,
  "description": "Vedoxa: premium digital books platform (spirituality, psychology, self-help) with Soul Echo support chat.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run build",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "framer-motion": "latest",
    "@supabase/supabase-js": "latest",
    "typescript": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "razorpay": "latest",
    "nprogress": "latest",
    "tailwindcss": "^3.4.1",
    "postcss": "latest",
    "autoprefixer": "latest",
    "react-icons": "latest",
    "react-pdf": "^9.1.0",
    "react-pageflip": "^2.0.3"
  },
  "overrides": {
    "react-pageflip": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "react-pdf": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
